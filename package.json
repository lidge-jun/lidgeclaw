    "test": "node plugins/cursorclaw/scripts/test.mjs \"plugins/cursorclaw/components/pabcd-state/test/*.test.ts\" \"plugins/cursorclaw/components/config-guard/test/*.test.ts\" \"plugins/cursorclaw/components/cxc-ops/test/*.test.ts\" \"plugins/cursorclaw/components/recall/test/*.test.ts\" \"plugins/cursorclaw/components/provider-bridge/test/*.test.ts\" \"plugins/cursorclaw/components/subagent-config/test/*.test.ts\" \"plugins/cursorclaw/components/messenger-bridge/test/*.test.ts\" \"plugins/cursorclaw/components/skill-search/test/*.test.ts\" \"plugins/cursorclaw/components/bg-wake/test/*.test.ts\" \"plugins/cursorclaw/gui/test/*.test.ts\" \"plugins/cursorclaw/test/*.test.mjs\" \".github/scripts/pr-labeler.test.cjs\" \".github/scripts/closed-pr-branch-cleanup.test.cjs\"",
    "smoke": "node plugins/cursorclaw/scripts/platform-smoke.mjs"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
