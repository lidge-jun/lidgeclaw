{
  "name": "lidgeclaw",
  "version": "0.3.0",
  "private": true,
  "description": "Umbrella for cursorclaw (Cursor) + zclaw (ZCode) — cli-jaw-style discipline from codexclaw.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidge-jun/lidgeclaw.git"
  },
  "license": "MIT",
  "bin": {
    "lidgeclaw": "bin/cursorclaw.mjs",
    "lc": "bin/cursorclaw.mjs",
    "cursorclaw": "bin/cursorclaw.mjs",
    "crc": "bin/cursorclaw.mjs"
  },
  "workspaces": [
    "plugins/cursorclaw/components/*",
    "plugins/cursorclaw/gui",
    "cli"
  ],
  "scripts": {
    "build": "node plugins/cursorclaw/scripts/build.mjs",
