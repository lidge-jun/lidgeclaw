{
  "description": "zclaw ZCode hooks (lidgeclaw)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/zcode-bridge.mjs", "SessionStart"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
