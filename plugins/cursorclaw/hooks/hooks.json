{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/cursor-bridge.mjs session-start"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/cursor-bridge.mjs beforeSubmitPrompt"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/cursor-bridge.mjs inject-pending"
      }
    ],
    "stop": [
      {
        "command": "node ./scripts/cursor-bridge.mjs stop",
        "loop_limit": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node ./scripts/cursor-bridge.mjs subagent-stop",
        "loop_limit": 5
      }
    ]
  }
}
